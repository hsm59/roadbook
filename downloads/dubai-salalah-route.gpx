  <metadata><name>Dubai to Salalah, 18-19 Aug 2026</name></metadata>
  <wpt lat="25.2930" lon="55.3650">
    <name>Al Nahda 1, Dubai</name>
    <desc>Day 1 (Departure) — Fill up here</desc>
    <sym>Flag</sym>
  </wpt>
  <wpt lat="24.0450" lon="55.8300">
    <name>Last UAE fuel</name>
    <desc>Day 1 (~8 km before Mezyad) — Fuel, Washroom, Food, Insurance</desc>
    <sym>Gas Station</sym>
  </wpt>
  <wpt lat="24.0231623" lon="55.8462712">
    <name>Mezyad Border Post</name>
    <desc>Day 1 (UAE exit) — Exit fee AED 35</desc>
    <sym>Flag</sym>
  </wpt>
  <wpt lat="24.0128417" lon="55.8482115">
    <name>Hafeet Border Post</name>
    <desc>Day 1 (Oman entry) — Visa, Customs, Insurance kiosk</desc>
    <sym>Flag</sym>
  </wpt>
  <wpt lat="23.2163282" lon="56.4925148">
    <name>Ibri</name>
    <desc>Day 1 (Oman Oil / Shell) — Fuel, Washroom, Food, ATM, SIM cards</desc>
    <sym>Gas Station</sym>
  </wpt>
  <wpt lat="22.8735362" lon="57.5363993">
    <name>Nizwa — hotel</name>
    <desc>Day 1 (Overnight) — Bed, Parking</desc>
    <sym>Flag</sym>
  </wpt>
  <wpt lat="22.3946927" lon="57.5147239">
    <name>Adam</name>
    <desc>Day 2 (Shell, Route 31) — Fuel — fill FULL, Washroom, Bakery, ATM, Mosque, Tyre air</desc>
    <sym>Gas Station</sym>
  </wpt>
  <wpt lat="21.3789567" lon="57.2538543">
    <name>Ghaba</name>
    <desc>Day 2 (Al Maha station) — Fuel, Washroom (rough), Grocery</desc>
    <sym>Gas Station</sym>
  </wpt>
  <wpt lat="19.9567873" lon="56.2758961">
    <name>Haima</name>
    <desc>Day 2 (Shell — halfway) — Fuel — fill FULL, Clean washroom, Restaurants, Mosque, ATM, Garage</desc>
    <sym>Gas Station</sym>
  </wpt>
  <wpt lat="19.1760410" lon="54.5019967">
    <name>Qitbit</name>
    <desc>Day 2 (Shell + motel) — Fuel, Family washroom, Restaurants, Mosque, Tyre repair</desc>
    <sym>Gas Station</sym>
  </wpt>
  <wpt lat="17.6107190" lon="54.0354019">
    <name>Thumrait</name>
    <desc>Day 2 (Shell — last fuel) — Fuel, Washroom, Restaurants, Mosque, ATM</desc>
    <sym>Gas Station</sym>
  </wpt>
  <wpt lat="17.0088533" lon="54.1576577">
    <name>Salalah Beach Resort</name>
    <desc>Day 2 (Arrival) — Arrived</desc>
    <sym>Flag</sym>
  </wpt>
